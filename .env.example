# Prisma / SQLite config DB (path is relative to prisma/schema.prisma)
DATABASE_URL="file:../data/config.sqlite"

# NextAuth session signing secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Default admin account created on first boot (when AdminUser table is empty).
ADMIN_INIT_USERNAME="admin"
ADMIN_INIT_PASSWORD="changeme"

# Optional tuning (see DESIGN.md §12.3)
# LOG_RETENTION_DAYS=30
# STAT_RETENTION_MONTHS=24
# QUOTA_EXHAUST_THRESHOLD=100
# METRICS_FLUSH_BATCH_SIZE=500
# SQLITE_POOL_MAX=16
