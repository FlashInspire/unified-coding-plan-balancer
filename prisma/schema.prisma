// unified-coding-plan-balancer — Prisma schema
// See DESIGN.md §3.1 for the data model rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Model — logical model / shared defaults. Model.id is the public model_id.
// -----------------------------------------------------------------------------
model Model {
  id                        String   @id // public model_id, e.g. "gpt-4o"
  displayName               String
  contextLength             Int
  maxTokens                 Int
  temperature               Float?
  topP                      Float?
  topK                      Int?
  minP                      Float?
  frequencyPenalty          Float?
  presencePenalty           Float?
  repetitionPenalty         Float?
  reasoningEffort           String? // "low" | "medium" | "high" | null
  includeReasoningInRequest Boolean  @default(false)
  vision                    Boolean  @default(false)
  enableThinking            Boolean?
  thinkingBudget            Int?
  enabled                   Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  providerModels ProviderModel[]
}

// -----------------------------------------------------------------------------
// Provider — upstream service vendor (OpenAI, Azure, OpenRouter, etc.).
// Each provider can expose both OpenAI-compatible and Anthropic-compatible
// endpoints. baseUrlOpenai / apiKeyOpenai and baseUrlAnthropic / apiKeyAnthropic
// are both optional; at least one pair must be configured.
// -----------------------------------------------------------------------------
model Provider {
  id                          String    @id // e.g. "openai-official", "azure-eu"
  name                        String
  baseUrlOpenai               String? // OpenAI-compatible endpoint URL
  apiKeyOpenai                String? // API key for OpenAI endpoint (plaintext; admin-only access)
  baseUrlAnthropic            String? // Anthropic-compatible endpoint URL
  apiKeyAnthropic             String? // API key for Anthropic endpoint
  headersTemplate             String // JSON-encoded extra headers template
  rollingQuota                BigInt?
  weekQuota                   BigInt?
  monthQuota                  BigInt?
  rollingQuotaUsed            Float     @default(0.0)
  weekQuotaUsed               Float     @default(0.0)
  monthQuotaUsed              Float     @default(0.0)
  rollingQuotaResetAt         DateTime?
  weekQuotaResetAt            DateTime?
  monthQuotaResetAt           DateTime?
  planStartTime               DateTime? // anchor for rolling (every 5h) & monthly resets; null = use createdAt
  // Usage mode: "request" = count requests (default), "token" = count tokens
  usageMode                   String    @default("request")
  // Token-mode counters (only meaningful when usageMode = "token").
  // *QuotaUsed fields are reused as "input tokens used" in token mode.
  rollingCacheInputTokensUsed Float     @default(0.0)
  rollingOutputTokensUsed     Float     @default(0.0)
  weekCacheInputTokensUsed    Float     @default(0.0)
  weekOutputTokensUsed        Float     @default(0.0)
  monthCacheInputTokensUsed   Float     @default(0.0)
  monthOutputTokensUsed       Float     @default(0.0)
  enabled                     Boolean   @default(true)
  quotaRunningOut             Boolean   @default(false) // marked true after MAX_QUOTA_RETRIES on exhausted provider
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  providerModels ProviderModel[]
}

// -----------------------------------------------------------------------------
// ProviderModel — instance of a Model on a specific Provider, with overrides.
// -----------------------------------------------------------------------------
model ProviderModel {
  id          String  @id @default(cuid())
  modelId     String
  providerId  String
  realModelId String? // upstream's true model id; null = use Model.id

  // All overrides are optional; NULL inherits from Model.
  contextLengthOverride             Int?
  maxTokensOverride                 Int?
  temperatureOverride               Float?
  topPOverride                      Float?
  topKOverride                      Int?
  reasoningEffortOverride           String?
  includeReasoningInRequestOverride Boolean?

  // Routing weight for ties in remaining quota.
  weight             Int     @default(1)
  // API style override: "auto" (follow client), "openai" or "anthropic" (force upstream protocol).
  apiStyle           String  @default("auto")
  // Fee rates: per-request (request mode) or per-token costs (token mode).
  feeRateInput       Float   @default(1.0)
  feeRateCachedInput Float   @default(0.1)
  feeRateOutput      Float   @default(4.0)
  enabled            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([modelId, providerId])
  @@index([modelId])
  @@index([providerId])
}

// -----------------------------------------------------------------------------
// ApiKey — externally issued bearer tokens. Plaintext returned only on create.
// Prefix is always "sk-y6-"; the full key = "sk-y6-" + randomPart.
// -----------------------------------------------------------------------------
model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique // SHA-256 hex of plaintext key
  name       String
  ownerId    String? // null = admin-owned (legacy keys)
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Per-dimension token counters (raw counts, no fee-rate weighting).
  rollingInputTokensUsed      Float     @default(0)
  rollingCachedReadTokensUsed Float     @default(0)
  rollingOutputTokensUsed     Float     @default(0)
  weekInputTokensUsed         Float     @default(0)
  weekCachedReadTokensUsed    Float     @default(0)
  weekOutputTokensUsed        Float     @default(0)
  monthInputTokensUsed        Float     @default(0)
  monthCachedReadTokensUsed   Float     @default(0)
  monthOutputTokensUsed       Float     @default(0)
  rollingQuotaResetAt         DateTime?
  weekQuotaResetAt            DateTime?
  monthQuotaResetAt           DateTime?

  owner AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

// -----------------------------------------------------------------------------
// AdminUser — admin console accounts (bcrypt-hashed password).
// -----------------------------------------------------------------------------
model AdminUser {
  id                          String    @id @default(cuid())
  username                    String    @unique
  passwordHash                String
  role                        String    @default("user") // "admin" | "user"
  email                       String? // optional, no validation
  displayName                 String? // shown in UI
  avatarUrl                   String? // optional URL; UI falls back to initial-letter circle
  mustChangePassword          Boolean   @default(false)
  lastSignInAt                DateTime?
  createdAt                   DateTime  @default(now())
  // Token quota (null or 0 = unlimited) — admin-editable only
  rollingQuota                BigInt?
  weekQuota                   BigInt?
  monthQuota                  BigInt?
  // Per-dimension token counters (weighted by multipliers).
  rollingInputTokensUsed      Float     @default(0)
  rollingCachedReadTokensUsed Float     @default(0)
  rollingOutputTokensUsed     Float     @default(0)
  weekInputTokensUsed         Float     @default(0)
  weekCachedReadTokensUsed    Float     @default(0)
  weekOutputTokensUsed        Float     @default(0)
  monthInputTokensUsed        Float     @default(0)
  monthCachedReadTokensUsed   Float     @default(0)
  monthOutputTokensUsed       Float     @default(0)
  rollingQuotaResetAt         DateTime?
  weekQuotaResetAt            DateTime?
  monthQuotaResetAt           DateTime?

  // Quota multipliers: how each token dimension counts against the quota budget.
  quotaMultiplierInput      Float @default(1.0)
  quotaMultiplierCachedRead Float @default(0.1)
  quotaMultiplierOutput     Float @default(4.0)

  preference UserPreference?
  apiKeys    ApiKey[]
}

// -----------------------------------------------------------------------------
// UserPreference — per-user UI preferences (language, theme).
// -----------------------------------------------------------------------------
model UserPreference {
  userId    String   @id
  language  String   @default("en") // "en" | "zh"
  theme     String   @default("system") // "light" | "dark" | "system"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// StickyRoute — per-API-key sticky routing to maximize KV-cache hit rates.
// Composite PK (apiKeyId, modelId) ensures one sticky entry per key+model.
// Expired entries are cleaned up lazily on read and by a periodic sweep.
// -----------------------------------------------------------------------------
model StickyRoute {
  apiKeyId   String
  modelId    String
  providerId String
  pmId       String
  expiresAt  DateTime

  @@id([apiKeyId, modelId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// SystemSetting — key-value store for runtime-configurable settings.
// DB values override env defaults. See lib/env.ts runtimeConfig.
// -----------------------------------------------------------------------------
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// RequestLog — individual API request log entries.
// Replaces the sharded SQLite request_log tables.
// -----------------------------------------------------------------------------
model RequestLog {
  id                BigInt  @id @default(autoincrement())
  ts                BigInt // epoch ms
  apiKeyId          String  @map("api_key_id")
  modelId           String  @map("model_id")
  providerId        String  @map("provider_id")
  realModelId       String  @map("real_model_id")
  apiModeIn         String  @map("api_mode_in")
  apiModeOut        String  @map("api_mode_out")
  stream            Boolean
  status            Int
  errorCode         String? @map("error_code")
  ttftMs            Int?    @map("ttft_ms")
  tpsOut            Float?  @map("tps_out")
  latencyMs         Int     @map("latency_ms")
  inputTokens       Int     @default(0) @map("input_tokens")
  cachedInputTokens Int     @default(0) @map("cached_input_tokens")
  outputTokens      Int     @default(0) @map("output_tokens")
  ip                String?
  userAgent         String? @map("user_agent")
  apiKeyName        String? @map("api_key_name")
  providerName      String? @map("provider_name")
  completed         Boolean @default(false)
  aborted           Boolean @default(false)

  @@index([ts])
  @@index([apiKeyId, ts])
  @@index([modelId, ts])
  @@index([providerId, ts])
  @@map("request_log")
}

// -----------------------------------------------------------------------------
// UsageMinute — per-minute aggregated usage.
// Replaces the sharded SQLite usage_minute tables.
// -----------------------------------------------------------------------------
model UsageMinute {
  minute            Int // epoch minute
  apiKeyId          String @map("api_key_id")
  providerId        String @map("provider_id")
  modelId           String @map("model_id")
  requests          Int    @default(0)
  requestsOk        Int    @default(0) @map("requests_ok")
  requestsErr       Int    @default(0) @map("requests_err")
  inputTokens       Int    @default(0) @map("input_tokens")
  cachedInputTokens Int    @default(0) @map("cached_input_tokens")
  outputTokens      Int    @default(0) @map("output_tokens")
  ttftMsSum         Int    @default(0) @map("ttft_ms_sum")
  ttftMsCount       Int    @default(0) @map("ttft_ms_count")
  tpsOutSum         Float  @default(0) @map("tps_out_sum")
  tpsOutCount       Int    @default(0) @map("tps_out_count")

  @@id([minute, apiKeyId, providerId, modelId])
  @@index([apiKeyId, minute])
  @@index([modelId, minute])
  @@map("usage_minute")
}

// -----------------------------------------------------------------------------
// AggregateReport — pre-aggregated reports at hour/day/week/month granularity.
// Dimensioned by (providerId, modelId, apiKeyId). Enables flexible queries
// across any single dimension or combination.
// -----------------------------------------------------------------------------
model AggregateReport {
  id          Int     @id @default(autoincrement())
  granularity String // "hour" | "day" | "week" | "month"
  periodStart BigInt  @map("period_start") // epoch ms of the period boundary
  providerId  String  @map("provider_id")
  modelId     String  @map("model_id")
  apiKeyId    String  @map("api_key_id")
  /// True for the single active (current) period row per (granularity, providerId, modelId, apiKeyId).
  /// When a period rolls over, this is set to false and a new row is created with latest=true.
  latest      Boolean @default(false)

  requests          Int      @default(0)
  requestsOk        Int      @default(0) @map("requests_ok")
  requestsErr       Int      @default(0) @map("requests_err")
  inputTokens       Int      @default(0) @map("input_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  ttftMsSum         Int      @default(0) @map("ttft_ms_sum")
  ttftMsCount       Int      @default(0) @map("ttft_ms_count")
  tpsOutSum         Float    @default(0) @map("tps_out_sum")
  tpsOutCount       Int      @default(0) @map("tps_out_count")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([granularity, periodStart, providerId, modelId, apiKeyId])
  @@index([granularity, periodStart])
  @@index([granularity, providerId, periodStart])
  @@index([granularity, modelId, periodStart])
  @@index([granularity, apiKeyId, periodStart])
  @@index([granularity, providerId, modelId, apiKeyId, latest])
  @@map("aggregate_report")
}
