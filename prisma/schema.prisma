// unified-coding-plan-balancer — Prisma schema
// See DESIGN.md §3.1 for the data model rationale.
// SQLite provider: no enums (use String + app-layer union types), Json stored as TEXT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// Model — logical model / shared defaults. Model.id is the public model_id.
// -----------------------------------------------------------------------------
model Model {
  id                        String   @id // public model_id, e.g. "gpt-4o"
  displayName               String
  contextLength             Int
  maxTokens                 Int
  temperature               Float?
  topP                      Float?
  topK                      Int?
  minP                      Float?
  frequencyPenalty          Float?
  presencePenalty           Float?
  repetitionPenalty         Float?
  reasoningEffort           String? // "low" | "medium" | "high" | null
  includeReasoningInRequest Boolean  @default(false)
  vision                    Boolean  @default(false)
  enableThinking            Boolean?
  thinkingBudget            Int?
  enabled                   Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  providerModels ProviderModel[]
}

// -----------------------------------------------------------------------------
// Provider — upstream service vendor (OpenAI, Azure, OpenRouter, etc.).
// Each provider can expose both OpenAI-compatible and Anthropic-compatible
// endpoints. baseUrlOpenai / apiKeyOpenai and baseUrlAnthropic / apiKeyAnthropic
// are both optional; at least one pair must be configured.
// -----------------------------------------------------------------------------
model Provider {
  id                          String    @id // e.g. "openai-official", "azure-eu"
  name                        String
  baseUrlOpenai               String? // OpenAI-compatible endpoint URL
  apiKeyOpenai                String? // API key for OpenAI endpoint (plaintext; admin-only access)
  baseUrlAnthropic            String? // Anthropic-compatible endpoint URL
  apiKeyAnthropic             String? // API key for Anthropic endpoint
  headersTemplate             String // JSON-encoded extra headers template
  rollingQuota                Int?
  weekQuota                   Int?
  monthQuota                  Int?
  rollingQuotaUsed            Float     @default(0.0)
  weekQuotaUsed               Float     @default(0.0)
  monthQuotaUsed              Float     @default(0.0)
  rollingQuotaResetAt         DateTime?
  weekQuotaResetAt            DateTime?
  monthQuotaResetAt           DateTime?
  planStartTime               DateTime? // anchor for rolling (every 5h) & monthly resets; null = use createdAt
  // Usage mode: "request" = count requests (default), "token" = count tokens
  usageMode                   String    @default("request")
  // Token-mode counters (only meaningful when usageMode = "token").
  // *QuotaUsed fields are reused as "input tokens used" in token mode.
  rollingCacheInputTokensUsed Float     @default(0.0)
  rollingOutputTokensUsed     Float     @default(0.0)
  weekCacheInputTokensUsed    Float     @default(0.0)
  weekOutputTokensUsed        Float     @default(0.0)
  monthCacheInputTokensUsed   Float     @default(0.0)
  monthOutputTokensUsed       Float     @default(0.0)
  enabled                     Boolean   @default(true)
  quotaRunningOut             Boolean   @default(false) // marked true after MAX_QUOTA_RETRIES on exhausted provider
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  providerModels ProviderModel[]
}

// -----------------------------------------------------------------------------
// ProviderModel — instance of a Model on a specific Provider, with overrides.
// -----------------------------------------------------------------------------
model ProviderModel {
  id          String  @id @default(cuid())
  modelId     String
  providerId  String
  realModelId String? // upstream's true model id; null = use Model.id

  // All overrides are optional; NULL inherits from Model.
  contextLengthOverride             Int?
  maxTokensOverride                 Int?
  temperatureOverride               Float?
  topPOverride                      Float?
  topKOverride                      Int?
  reasoningEffortOverride           String?
  includeReasoningInRequestOverride Boolean?

  // Routing weight for ties in remaining quota.
  weight             Int     @default(1)
  // API style override: "auto" (follow client), "openai" or "anthropic" (force upstream protocol).
  apiStyle           String  @default("auto")
  // Fee rates: per-request (request mode) or per-token costs (token mode).
  feeRateInput       Float   @default(1.0)
  feeRateCachedInput Float   @default(0.1)
  feeRateOutput      Float   @default(4.0)
  enabled            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([modelId, providerId])
  @@index([modelId])
  @@index([providerId])
}

// -----------------------------------------------------------------------------
// ApiKey — externally issued bearer tokens. Plaintext returned only on create.
// Prefix is always "sk-y6-"; the full key = "sk-y6-" + randomPart.
// -----------------------------------------------------------------------------
model ApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique // SHA-256 hex of plaintext key
  name      String
  ownerId   String?   // null = admin-owned (legacy keys)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?

  owner AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

// -----------------------------------------------------------------------------
// AdminUser — admin console accounts (bcrypt-hashed password).
// -----------------------------------------------------------------------------
model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               String    @default("user") // "admin" | "user"
  email              String? // optional, no validation
  displayName        String? // shown in UI
  avatarUrl          String? // optional URL; UI falls back to initial-letter circle
  mustChangePassword Boolean   @default(false)
  lastSignInAt       DateTime?
  createdAt          DateTime  @default(now())
  // Token quota (null or 0 = unlimited) — admin-editable only
  rollingQuota        Int?
  weekQuota           Int?
  monthQuota          Int?
  tokensUsed          Int       @default(0) // current period tokens (input+cached+output)
  rollingQuotaResetAt DateTime?
  weekQuotaResetAt    DateTime?
  monthQuotaResetAt   DateTime?

  preference UserPreference?
  apiKeys    ApiKey[]
}

// -----------------------------------------------------------------------------
// UserPreference — per-user UI preferences (language, theme).
// -----------------------------------------------------------------------------
model UserPreference {
  userId    String   @id
  language  String   @default("en") // "en" | "zh"
  theme     String   @default("system") // "light" | "dark" | "system"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// StickyRoute — per-API-key sticky routing to maximize KV-cache hit rates.
// Composite PK (apiKeyId, modelId) ensures one sticky entry per key+model.
// Expired entries are cleaned up lazily on read and by a periodic sweep.
// -----------------------------------------------------------------------------
model StickyRoute {
  apiKeyId   String
  modelId    String
  providerId String
  pmId       String
  expiresAt  DateTime

  @@id([apiKeyId, modelId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// SystemSetting — key-value store for runtime-configurable settings.
// DB values override env defaults. See lib/env.ts runtimeConfig.
// -----------------------------------------------------------------------------
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
